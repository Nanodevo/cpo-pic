<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>cpo-pic bonded stack (glass / IOX / adhesive / silicon)</description>
 <version/>
 <category>d25</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>true</show-in-menu>
 <group-name>d25_scripts</group-name>
 <menu-path>tools_menu.d25.end</menu-path>
 <interpreter>dsl</interpreter>
 <dsl-interpreter-name>d25-dsl-xml</dsl-interpreter-name>
 <text>
# Bonded stack of chain/taper_eme.py, for stack_shaped.gds (units: micrometres).
# glass below, ion-exchanged guide sunk into its top face, 1 um adhesive, 220 nm silicon on top.
z(input(4, 0), zstart: -8.0, zstop: 0.0,  name: "glass",     color: 0xa9c4d8)
z(input(2, 0), zstart: -4.0, zstop: 0.0,  name: "IOX guide", color: 0xc8698a)
z(input(3, 0), zstart:  0.0, zstop: 1.0,  name: "adhesive",  color: 0xe9d8a6)
z(input(1, 0), zstart:  1.0, zstop: 1.22, name: "silicon",   color: 0x1b6ca8)

</text>
</klayout-macro>
